<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="21225" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="21225"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PropertiesViewController">
            <connections>
                <outlet property="objectController" destination="99" id="100"/>
                <outlet property="view" destination="1" id="98"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="1" userLabel="Snippet Properties">
            <rect key="frame" x="0.0" y="0.0" width="199" height="36"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
            <subviews>
                <button translatesAutoresizingMaskIntoConstraints="NO" id="96">
                    <rect key="frame" x="18" y="19" width="161" height="18"/>
                    <buttonCell key="cell" type="check" title="Automatic indentation" bezelStyle="regularSquare" imagePosition="left" alignment="left" state="on" inset="2" id="97">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <binding destination="99" name="value" keyPath="selection.disableAutoIndent" id="128">
                            <dictionary key="options">
                                <string key="NSValueTransformerName">NSNegateBoolean</string>
                            </dictionary>
                        </binding>
                    </connections>
                </button>
            </subviews>
            <constraints>
                <constraint firstItem="96" firstAttribute="top" secondItem="1" secondAttribute="top" id="D8r-Zo-yZP"/>
                <constraint firstAttribute="trailing" secondItem="96" secondAttribute="trailing" constant="20" symbolic="YES" id="Oa2-4u-Dwc"/>
                <constraint firstAttribute="bottom" secondItem="96" secondAttribute="bottom" constant="20" symbolic="YES" id="Paf-XD-n46"/>
                <constraint firstItem="96" firstAttribute="leading" secondItem="1" secondAttribute="leading" constant="20" symbolic="YES" id="i1p-fD-S8M"/>
            </constraints>
            <point key="canvasLocation" x="-168" y="129"/>
        </customView>
        <objectController id="99">
            <declaredKeys>
                <string>disableAutoIndent</string>
            </declaredKeys>
            <connections>
                <binding destination="-2" name="contentObject" keyPath="properties" id="109"/>
            </connections>
        </objectController>
    </objects>
</document>
