<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>nop</string>
	<key>command</key>
	<string>#!/bin/bash

# Shown only while ruff/pyright are missing (showOnlyIfExecutableMissing).
# Explains how to install the checkers; offers to copy the brew command.

BTN=$(osascript \
	-e 'display alert "Install Python Checkers" message "Python Diagnostics uses Ruff (linting, quick fixes) and Pyright (type checking). Either one alone also works.\n\nInstall with Homebrew:\n\n    brew install ruff pyright\n\nAfter installing, save any Python file to see diagnostics." buttons {"Copy Command", "OK"} default button "OK"' \
	-e 'button returned of result' 2&gt;/dev/null)
if [[ "$BTN" == "Copy Command" ]]; then
	printf 'brew install ruff pyright' | pbcopy
fi
</string>
	<key>input</key>
	<string>none</string>
	<key>name</key>
	<string>Install Ruff and Pyright…</string>
	<key>outputLocation</key>
	<string>discard</string>
	<key>scope</key>
	<string></string>
	<key>showOnlyIfExecutableMissing</key>
	<string>ruff pyright</string>
	<key>uuid</key>
	<string>9D4E2C77-0B3A-4F4E-8E19-53F0A3B4C702</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
